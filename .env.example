# Servidor
PORT=7546
MAX_UPLOAD_MB=20

# Titular usado enquanto não há autenticação (RF-01/02). Pode ser sobrescrito pelo header X-Owner-ID.
DEV_OWNER_ID=dev-titular

# Postgres
DATABASE_URL=postgres://carteira:SENHA@127.0.0.1:5432/carteira?sslmode=disable

# MinIO / S3. Endpoint aceita host:porta ou URL completa (https:// liga TLS).
MINIO_ENDPOINT=https://s3.exemplo.com
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=carteira
MINIO_USE_PATH_STYLE_ENDPOINT=true
# Usado só quando o endpoint não tem esquema
MINIO_USE_SSL=false
